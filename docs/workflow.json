{
    "base": "main",
    "exclude": {},
    "project_marker": "docs/{project}",
    "topic_prefix": "{project}-",
    "todo": "docs/{project}/todo.md",
    "issues": "docs/{project}/issues",
    "report": "(?P<state>open|done|wont)-(?P<kind>bug|enh)-(?P<name>\\w+)\\.md",
    "report_name": "{state}-{kind}-{name}.md",
    "report_kinds": {"bug": "root-cause-analysis", "enh": "enhancement-report"},
    "open_state": "open",
    "closed_states": ["done", "wont"],
    "closed_dir": "done",
    "log": "docs/{project}/done.md",
    "markers": {
        "x": "closed, ready for compaction",
        "~": "waiting on confirmation",
        "+": "carries a note from a confirmation round",
        " ": "open"
    },
    "closed_marker": "x",
    "report_markers": ["x", "~", "+"],
    "kinds": {"src": "code", "docs": "docs", "tools": "tools"},
    "wip_refs": "refs/wip",
    "wip_tag_file": "wip-tag",
    "claim_file": "claims",
    "claim_refs": "refs/claims",
    "series": "tools/buildseries.sh {mod} {target}",
    "version_tag": "v{version}",
    "worktree": {
        "dir": ".worktrees",
        "link": [],
        "copy": [],
        "run": [],
        "note": ""
    },
    "deploy": {
        "source": "src/{project}",
        "artefact": "/home/robyn/.local/share/uv/tools/{project}/bin/{project}",
        "ignore": [],
        "record": null,
        "build": "tools/build.sh {project} --force",
        "shared": true
    },
    "confirm": {
        "who": "Robyn",
        "how": "Robyn runs the installed claude-viewer on a real session, tries the item's Test line, and notes the result on the item in todo.md",
        "summary": null,
        "follow": null,
        "evidence": "Robyn's note on the item in todo.md"
    }
}
